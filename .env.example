# =============================================================================
# PROCURE360 — native Windows configuration
# Copy this file to `.env` and change the secrets before first use.
# Setup.cmd fills these in automatically for the bundled Windows installer.
# =============================================================================

# Public port for the web application. Staff open http://<server-ip>:APP_PORT
APP_PORT=8080

# Application
ENVIRONMENT=production
SECRET_KEY=change-this-to-a-long-random-secret-at-least-48-characters
ACCESS_TOKEN_EXPIRE_MINUTES=480

# SQLite database. Setup.cmd replaces this with an absolute path inside the
# bundle's data folder, for example C:/PROCURE360/data/procure360.db.
DATABASE_URL=sqlite:///./data/procure360.db

# The native installer runs Alembic before the service starts, so the app does
# not create tables itself in production.
AUTO_CREATE_TABLES=false

# Never create demo users, contractors or sample contracts.
SEED_DEMO_DATA=false

# Automatic SQLite backups (native Windows deployment)
BACKUP_ENABLED=true
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

# Watchlist thresholds (days)
COMPLETION_WATCHLIST_DAYS=45
BOND_WATCHLIST_DAYS=60
BEC_ALERT_DAYS=0

# Optional explicit CORS origins. The API also accepts private LAN origins by
# default (10.x, 172.16-31.x, 192.168.x). Comma-separated.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Time zone used for dates and notifications
TZ=Asia/Colombo

# -----------------------------------------------------------------------------
# Optional: Docker Compose development/deployment settings
# The native bundle does not use PostgreSQL; these are only read if you run the
# repository's docker-compose.yml.
# -----------------------------------------------------------------------------
# POSTGRES_DB=procure360
# POSTGRES_USER=procure360
# POSTGRES_PASSWORD=change-this-database-password
# POSTGRES_PORT=5432
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_RETENTION_DAYS=14
# DEMO_PASSWORD=change-this-demo-password-if-used
